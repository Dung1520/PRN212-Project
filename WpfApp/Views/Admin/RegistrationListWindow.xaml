<Window x:Class="WpfApp.Views.Admin.RegistrationListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:WpfApp.Converters"
        mc:Ignorable="d"
        Title="Registration List"
        Height="650"
        Width="1300"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Text căn giữa -->
        <Style x:Key="CenteredTextStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Cell căn giữa -->
        <Style x:Key="CenteredCellStyle" TargetType="DataGridCell">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Approve button -->
        <Style x:Key="ApproveButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="78"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="BorderBrush" Value="#15803D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- Reject button -->
        <Style x:Key="RejectButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="78"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#B91C1C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- Ô trạng thái cuối -->
        <Style x:Key="FinalStatusBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <!-- Text trạng thái cuối -->
        <Style x:Key="FinalStatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding FinalStatusText}" Value="Cancel">
                    <Setter Property="Foreground" Value="#6B7280"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding FinalStatusText}" Value="Rejected">
                    <Setter Property="Foreground" Value="#B91C1C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding FinalStatusText}" Value="Approved">
                    <Setter Property="Foreground" Value="#15803D"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Registration List"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">
            <TextBox x:Name="txtKeyword"
                     Width="220"
                     Height="32"
                     Margin="0,0,10,0"
                     VerticalContentAlignment="Center"/>

            <ComboBox x:Name="cbStatusFilter"
                      Width="140"
                      Height="32"
                      Margin="0,0,10,0"
                      SelectedIndex="0">
                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="Pending"/>
                <ComboBoxItem Content="Approved"/>
                <ComboBoxItem Content="Rejected"/>
                <ComboBoxItem Content="Cancel"/>
            </ComboBox>

            <Button Content="Search"
                    Width="100"
                    Height="32"
                    Margin="0,0,10,0"
                    Click="BtnSearch_Click"/>

            <Button Content="Refresh"
                    Width="100"
                    Height="32"
                    Click="BtnRefresh_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgRegistrations"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  ColumnHeaderHeight="32"
                  RowHeaderWidth="0"
                  CellStyle="{StaticResource CenteredCellStyle}">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Enrollment ID" Binding="{Binding EnrollmentId}" Width="90" ElementStyle="{StaticResource CenteredTextStyle}"/>
                <DataGridTextColumn Header="Student Code" Binding="{Binding StudentCode}" Width="100" ElementStyle="{StaticResource CenteredTextStyle}"/>
                <DataGridTextColumn Header="Student Name" Binding="{Binding StudentName}" Width="170" ElementStyle="{StaticResource CenteredTextStyle}"/>
                <DataGridTextColumn Header="Email" Binding="{Binding StudentEmail}" Width="200" ElementStyle="{StaticResource CenteredTextStyle}"/>
                <DataGridTextColumn Header="Class Code" Binding="{Binding ClassCode}" Width="100" ElementStyle="{StaticResource CenteredTextStyle}"/>
                <DataGridTextColumn Header="Capacity" Binding="{Binding Capacity}" Width="70" ElementStyle="{StaticResource CenteredTextStyle}"/>
                <DataGridTextColumn Header="Approved" Binding="{Binding ApprovedCount}" Width="70" ElementStyle="{StaticResource CenteredTextStyle}"/>
                <DataGridTextColumn Header="Remain" Binding="{Binding RemainingSeats}" Width="70" ElementStyle="{StaticResource CenteredTextStyle}"/>
                <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="100" ElementStyle="{StaticResource CenteredTextStyle}"/>
                <DataGridTextColumn Header="Enrollment Status" Binding="{Binding EnrollmentStatus}" Width="120" ElementStyle="{StaticResource CenteredTextStyle}"/>
                <DataGridTextColumn Header="Class Status" Binding="{Binding ClassStatus}" Width="90" ElementStyle="{StaticResource CenteredTextStyle}"/>
                <DataGridTextColumn Header="Registered At" Binding="{Binding RegisteredAt, StringFormat=dd/MM/yyyy HH:mm}" Width="140" ElementStyle="{StaticResource CenteredTextStyle}"/>

                <DataGridTemplateColumn Header="Status" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Cụm nút -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding ShowFinalStatus, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                    <Button Content="Approve"
                                            Style="{StaticResource ApproveButtonStyle}"
                                            Margin="0,0,8,0"
                                            Click="BtnApprove_Click"
                                            Visibility="{Binding CanApprove, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <Button Content="Reject"
                                            Style="{StaticResource RejectButtonStyle}"
                                            Click="BtnReject_Click"
                                            Visibility="{Binding CanReject, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>

                                <!-- Trạng thái cuối -->
                                <Border Style="{StaticResource FinalStatusBorderStyle}"
                                        Visibility="{Binding ShowFinalStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding FinalStatusText}"
                                               Style="{StaticResource FinalStatusTextStyle}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>