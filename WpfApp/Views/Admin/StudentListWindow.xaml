<Window x:Class="WpfApp.Views.Admin.StudentListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student List"
        Height="650"
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="CenteredTextStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CenteredCellStyle" TargetType="DataGridCell">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <Button Content="Back"
                    Width="90"
                    Height="32"
                    DockPanel.Dock="Left"
                    Click="BtnBack_Click"/>
            <TextBlock Text="Student List"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBox x:Name="txtKeyword"
                     Width="250"
                     Height="32"
                     Margin="0,0,10,0"
                     VerticalContentAlignment="Center"/>

            <Button Content="Search"
                    Width="100"
                    Height="32"
                    Margin="0,0,10,0"
                    Click="BtnSearch_Click"/>

            <Button Content="Refresh"
                    Width="100"
                    Height="32"
                    Click="BtnRefresh_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgStudents"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CellStyle="{StaticResource CenteredCellStyle}"
                  RowHeaderWidth="0">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Student Code" Binding="{Binding StudentCode}" Width="120" ElementStyle="{StaticResource CenteredTextStyle}"/>
                <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="220" ElementStyle="{StaticResource CenteredTextStyle}"/>
                <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="100" ElementStyle="{StaticResource CenteredTextStyle}"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220" ElementStyle="{StaticResource CenteredTextStyle}"/>
                <DataGridTextColumn Header="Phone Number" Binding="{Binding PhoneNumber}" Width="140" ElementStyle="{StaticResource CenteredTextStyle}"/>
                <DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="90" ElementStyle="{StaticResource CenteredTextStyle}"/>

                <DataGridTemplateColumn Header="Action" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="View Detail"
                                    Width="90"
                                    Height="28"
                                    Click="BtnViewDetail_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>