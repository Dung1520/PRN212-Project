<Window x:Class="WpfApp.Views.Admin.TeacherDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teacher Detail"
        Height="550"
        Width="600"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Teacher Profile Detail"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Teacher Code:" Grid.Row="0" FontWeight="SemiBold"/>
            <TextBlock x:Name="txtTeacherCode" Grid.Row="0" Grid.Column="1"/>

            <TextBlock Text="Username:" Grid.Row="1" FontWeight="SemiBold"/>
            <TextBlock x:Name="txtUsername" Grid.Row="1" Grid.Column="1"/>

            <TextBlock Text="Full Name:" Grid.Row="2" FontWeight="SemiBold"/>
            <TextBlock x:Name="txtFullName" Grid.Row="2" Grid.Column="1"/>

            <TextBlock Text="Email:" Grid.Row="3" FontWeight="SemiBold"/>
            <TextBlock x:Name="txtEmail" Grid.Row="3" Grid.Column="1"/>

            <TextBlock Text="Phone Number:" Grid.Row="4" FontWeight="SemiBold"/>
            <TextBlock x:Name="txtPhoneNumber" Grid.Row="4" Grid.Column="1"/>

            <TextBlock Text="Gender:" Grid.Row="5" FontWeight="SemiBold"/>
            <TextBlock x:Name="txtGender" Grid.Row="5" Grid.Column="1"/>

            <TextBlock Text="Date Of Birth:" Grid.Row="6" FontWeight="SemiBold"/>
            <TextBlock x:Name="txtDateOfBirth" Grid.Row="6" Grid.Column="1"/>

            <TextBlock Text="Address:" Grid.Row="7" FontWeight="SemiBold"/>
            <TextBlock x:Name="txtAddress" Grid.Row="7" Grid.Column="1"/>

            <TextBlock Text="Is Active:" Grid.Row="8" FontWeight="SemiBold"/>
            <TextBlock x:Name="txtIsActive" Grid.Row="8" Grid.Column="1"/>

            <TextBlock Text="Created At:" Grid.Row="9" FontWeight="SemiBold"/>
            <TextBlock x:Name="txtCreatedAt" Grid.Row="9" Grid.Column="1"/>
        </Grid>

        <Button Grid.Row="2"
                Content="Close"
                Width="100"
                Height="32"
                HorizontalAlignment="Right"
                Margin="0,20,0,0"
                Click="BtnClose_Click"/>
    </Grid>
</Window>