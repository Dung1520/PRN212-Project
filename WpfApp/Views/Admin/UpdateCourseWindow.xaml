<Window x:Class="WpfApp.UpdateCourseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="UpdateCourseWindow" Height="450" Width="800">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Cập nhật khóa học" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Chỉnh sửa thông tin khóa học" FontSize="12"/>
        </StackPanel>

        <!-- FORM -->
        <ScrollViewer Grid.Row="1">
            <StackPanel>

                <!-- Code -->
                <TextBlock Text="Mã khóa học *"/>
                <TextBox x:Name="txtCourseCode"/>

                <!-- Name -->
                <TextBlock Text="Tên khóa học *" Margin="0,10,0,0"/>
                <TextBox x:Name="txtName"/>

                <!-- Subject -->
                <TextBlock Text="Chuyên ngành" Margin="0,10,0,0"/>
                <ComboBox x:Name="cbSubject">
                    <ComboBoxItem Content="CNTT"/>
                    <ComboBoxItem Content="Kinh tế"/>
                    <ComboBoxItem Content="Thiết kế"/>
                </ComboBox>

                <!-- Duration -->
                <TextBlock Text="Thời lượng (tuần)" Margin="0,10,0,0"/>
                <TextBox x:Name="txtDuration"/>

                <!-- Fee -->
                <TextBlock Text="Học phí (VNĐ)" Margin="0,10,0,0"/>
                <TextBox x:Name="txtFee"/>

                <!-- Status -->
                <TextBlock Text="Trạng thái" Margin="0,10,0,0"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="rbOpen" Content="Open" IsChecked="True"/>
                    <RadioButton x:Name="rbClosed" Content="Closed" Margin="20,0,0,0"/>
                </StackPanel>

                <!-- Description -->
                <TextBlock Text="Mô tả" Margin="0,10,0,0"/>
                <TextBox x:Name="txtDescription" Height="80" AcceptsReturn="True"/>

            </StackPanel>
        </ScrollViewer>

        <!-- BUTTON -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">

            <Button Content="Hủy"
                Width="100"
                Margin="0,0,10,0"
                Click="Cancel_Click"/>

            <Button Content="Cập nhật"
                Width="120"
                Background="#4A90E2"
                Foreground="White"
                Click="Update_Click"/>
        </StackPanel>
    </Grid>
</Window>
