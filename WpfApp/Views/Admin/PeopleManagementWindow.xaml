<Window x:Class="WpfApp.Views.Admin.PeopleManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="People Management"
        Height="300"
        Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Choose List"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,30"/>

        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <Button Content="Student List"
                    Width="220"
                    Height="50"
                    Margin="0,0,0,15"
                    Click="BtnStudentList_Click"/>

            <Button Content="Teacher List"
                    Width="220"
                    Height="50"
                    Click="BtnTeacherList_Click"/>
        </StackPanel>
    </Grid>
</Window>