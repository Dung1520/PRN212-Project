<Window x:Class="WpfApp.Window1_Course_"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="Window1_Course_" Height="450" Width="953">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <StackPanel Width="700">
                <TextBlock Text="Danh sách khóa học" FontSize="26" FontWeight="Bold" Foreground="#2D3748"/>
                <TextBlock Text="Quản lý thông tin khóa học" Foreground="#718096"/>
            </StackPanel>

            <Button Content="+ Thêm khóa học"
                Background="#4A90E2"
                Foreground="White"
                Padding="15,8"
                BorderThickness="0"
                FontWeight="Bold"
                Click="BtnAdd_Click"/>
        </StackPanel>

        <!-- DATAGRID -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#E2E8F0" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>

            <DataGrid x:Name="dgCourses"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  RowHeight="45">

                <!-- HEADER STYLE -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Foreground" Value="#718096"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- COLUMNS -->
                <DataGrid.Columns>

                    <!-- Code -->
                    <DataGridTextColumn Header="MÃ KHÓA HỌC"
                                    Binding="{Binding CourseCode}"
                                    Width="100"/>

                    <!-- Name -->
                    <DataGridTextColumn Header="TÊN KHÓA HỌC"
                                    Binding="{Binding Name}"
                                    Width="200"/>

                    <!-- Subject -->
                    <DataGridTextColumn Header="MÔN"
                                    Binding="{Binding SubjectCourse}"
                                    Width="150"/>

                    <!-- Duration -->
                    <DataGridTextColumn Header="THỜI GIAN"
                                    Binding="{Binding DurationWeeks}"
                                    Width="100"/>

                    <!-- Fee -->
                    <DataGridTextColumn Header="HỌC PHÍ"
                                    Binding="{Binding Fee, StringFormat={}{0:N0} VNĐ}"
                                    Width="120"/>

                    <!-- Status -->
                    <DataGridTextColumn Header="TRẠNG THÁI"
                                    Binding="{Binding Status}"
                                    Width="100"/>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="THAO TÁC" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">

                                    <Button Content="Sửa"
                                        Margin="0,0,5,0"
                                         Click="BtnEdit_Click"/>

                                    <Button Content="Xóa"
                                        />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
