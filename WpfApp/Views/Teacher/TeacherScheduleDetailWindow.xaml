<Window x:Class="WpfApp.Views.TeacherScheduleDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp.Views"
        mc:Ignorable="d"
        Title="TeacherScheduleDetailWindow" Height="450" Width="550">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="txtClassInfo" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock x:Name="txtRoom" Margin="0,0,0,6"/>
            <TextBlock x:Name="txtTime" Margin="0,0,0,6"/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Student List" Margin="0,12,0,12">
            <ListBox x:Name="lstStudents"/>
        </GroupBox>

        <Button Grid.Row="2" Content="Close" Width="100" HorizontalAlignment="Right" Click="Close_Click"/>
    </Grid>
</Window>
