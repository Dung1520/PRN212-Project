<UserControl x:Class="WpfApp.Views.AdminClassesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.1*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,18,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBox x:Name="SearchTextBox" Width="260" Height="34" VerticalContentAlignment="Center"/>
                <Button Width="100" Margin="8,0,0,0" Content="Tìm" Click="SearchButton_Click"/>
                <Button Width="120" Margin="8,0,0,0" Content="Làm mới" Click="ReloadButton_Click"/>
                <Button Width="100" Margin="8,0,0,0" Content="Add" Click="AddButton_Click"/>
            </StackPanel>

            <TextBlock DockPanel.Dock="Top" Text="Danh sách lớp" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>

            <DataGrid x:Name="ClassGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Code" Binding="{Binding ClassCode}" Width="120"/>
                    <DataGridTextColumn Header="CourseId" Binding="{Binding CourseId}" Width="80"/>
                    <DataGridTextColumn Header="TeacherId" Binding="{Binding TeacherId}" Width="80"/>
                    <DataGridTextColumn Header="Bắt đầu" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="110"/>
                    <DataGridTextColumn Header="Kết thúc" Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}" Width="110"/>
                    <DataGridTextColumn Header="Sức chứa" Binding="{Binding Capacity}" Width="80"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="100"/>
                    <DataGridTemplateColumn Header="Edit" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Edit" Click="EditButton_Click" Tag="{Binding Id}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Column="1" Background="#F8FAFC" Padding="16" CornerRadius="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="ModeText" Text="Chưa chọn thao tác" FontSize="14" FontWeight="SemiBold" Foreground="#1D4ED8" Margin="0,0,0,8"/>
                    <TextBlock Text="Form lớp học" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>

                    <StackPanel x:Name="ActionHintPanel">
                        <TextBlock Text="Bấm Add để thêm lớp mới hoặc bấm Edit ở bảng bên trái để sửa." TextWrapping="Wrap" Foreground="#475569"/>
                    </StackPanel>

                    <StackPanel x:Name="FormPanel" Visibility="Collapsed">
                        <TextBlock Text="Class Code"/>
                        <TextBox x:Name="ClassCodeTextBox" Margin="0,6,0,10"/>

                        <TextBlock Text="Course"/>
                        <ComboBox x:Name="CourseComboBox"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  Margin="0,6,0,10"
                                  SelectionChanged="CourseComboBox_SelectionChanged"/>

                        <TextBlock Text="Teacher"/>
                        <ComboBox x:Name="TeacherComboBox"
                                  DisplayMemberPath="FullName"
                                  SelectedValuePath="Id"
                                  Margin="0,6,0,10"/>

                        <TextBlock Text="Start Date"/>
                        <DatePicker x:Name="StartDatePicker"
                                    Margin="0,6,0,10"
                                    SelectedDateChanged="StartDatePicker_SelectedDateChanged"/>

                        <TextBlock Text="End Date (auto)"/>
                        <TextBox x:Name="EndDateTextBox"
                                 Margin="0,6,0,10"
                                 IsReadOnly="True"
                                 Background="#E5E7EB"/>

                        <TextBlock Text="Capacity"/>
                        <TextBox x:Name="CapacityTextBox" Margin="0,6,0,10"/>

                        <TextBlock Text="Status"/>
                        <ComboBox x:Name="ClassStatusComboBox" Margin="0,6,0,14">
                            <ComboBoxItem Content="Open" IsSelected="True"/>
                            <ComboBoxItem Content="Full"/>
                            <ComboBoxItem Content="Closed"/>
                        </ComboBox>

                        <TextBlock Text="Lịch học" FontWeight="Bold" Margin="0,8,0,8"/>

                        <DataGrid x:Name="ScheduleGrid"
                                  Height="240"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="False"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Day" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.DayOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      DisplayMemberPath="Text"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding DayOfWeek, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      MinWidth="100"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Slot" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.SlotOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      DisplayMemberPath="SlotName"
                                                      SelectedValuePath="Id"
                                                      SelectedValue="{Binding SlotId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      MinWidth="100"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Room" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding RoomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     MinWidth="120"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <WrapPanel Margin="0,8,0,12">
                            <Button Width="90" Margin="0,0,8,0" Content="+ Schedule" Click="AddScheduleRow_Click"/>
                            <Button Width="90" Content="- Schedule" Click="RemoveScheduleRow_Click"/>
                        </WrapPanel>

                        <WrapPanel>
                            <Button Width="120" Margin="0,0,8,8" Content="Lưu" Click="SaveButton_Click"/>
                            <Button Width="100" Margin="0,0,8,8" Content="Back" Click="BackButton_Click"/>
                            <Button Width="100" Margin="0,0,8,8" Content="Clear" Click="Clear_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="Crimson"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>