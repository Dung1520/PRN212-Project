<UserControl x:Class="WpfApp.Views.AdminRegistrationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <ComboBox x:Name="StatusComboBox" Width="140" SelectedIndex="0">
                <ComboBoxItem Content="All" IsSelected="True"/>
                <ComboBoxItem Content="Pending"/>
                <ComboBoxItem Content="Approved"/>
                <ComboBoxItem Content="Rejected"/>
                <ComboBoxItem Content="Cancel"/>
            </ComboBox>
            <TextBox x:Name="KeywordTextBox" Margin="8,0,0,0" Width="260" Height="34" VerticalContentAlignment="Center"/>
            <Button Margin="8,0,0,0" Width="100" Content="Tìm" Click="Search_Click"/>
            <Button Margin="8,0,0,0" Width="100" Content="Làm mới" Click="Reload_Click"/>
        </StackPanel>
        <DataGrid x:Name="RegistrationGrid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="EnrollmentId" Binding="{Binding EnrollmentId}" Width="90"/>
                <DataGridTextColumn Header="Student" Binding="{Binding StudentName}" Width="180"/>
                <DataGridTextColumn Header="Email" Binding="{Binding StudentEmail}" Width="180"/>
                <DataGridTextColumn Header="Class" Binding="{Binding ClassCode}" Width="100"/>
                <DataGridTextColumn Header="Status" Binding="{Binding EnrollmentStatus}" Width="90"/>
                <DataGridTextColumn Header="Approved/Capacity" Binding="{Binding ApprovedCount}" Width="90"/>
                <DataGridTemplateColumn Header="Approve" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Approve" IsEnabled="{Binding CanApprove}" Click="Approve_Click" Tag="{Binding EnrollmentId}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Reject" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Reject" IsEnabled="{Binding CanReject}" Click="Reject_Click" Tag="{Binding EnrollmentId}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>