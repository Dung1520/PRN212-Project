<Window x:Class="WpfApp.Views.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp.Views"
        mc:Ignorable="d"
        Title="Schedule"
        Height="650"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F7F7F7">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Padding="0,0,0,10"
                BorderBrush="#D0D0D0"
                BorderThickness="0,0,0,1">
            <TextBlock Text="SCHEDULE"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#333333"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Week navigation -->
        <Grid Grid.Row="1" Margin="0,14,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="txtWeekRange"
                       Grid.Column="0"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#333333"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="btnPrevWeek"
                        Content="&lt;"
                        Width="34"
                        Height="30"
                        Margin="0,0,8,0"
                        Click="btnPrevWeek_Click"/>

                <Button x:Name="btnToday"
                        Content="Today"
                        Width="70"
                        Height="30"
                        Margin="0,0,8,0"
                        Click="btnToday_Click"/>

                <Button x:Name="btnNextWeek"
                        Content="&gt;"
                        Width="34"
                        Height="30"
                        Click="btnNextWeek_Click"/>
            </StackPanel>
        </Grid>

        <!-- Schedule grid -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#BFBFBF"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  CanContentScroll="True">
                <Grid x:Name="ScheduleGrid" Margin="0"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
