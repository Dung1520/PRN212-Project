<UserControl x:Class="WpfApp.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#FFF5F7FB">
        <Border Width="560"
                Padding="28"
                Background="White"
                CornerRadius="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="HeaderText"
                           Text="Đăng nhập hệ thống"
                           FontSize="28"
                           FontWeight="Bold"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- LOGIN PANEL -->
                        <StackPanel x:Name="LoginPanel">
                            <TextBlock Margin="0,10,0,14"
                                       Foreground="#475569"
                                       Text="Đăng nhập bằng Username hoặc Email."/>

                            <TextBlock Text="Username hoặc Email"/>
                            <TextBox x:Name="UsernameTextBox"
                                     Margin="0,8,0,14"
                                     Height="36"/>

                            <TextBlock Text="Mật khẩu"/>
                            <PasswordBox x:Name="PasswordTextBox"
                                         Margin="0,8,0,18"
                                         Height="36"/>

                            <Button Height="40"
                                    Content="Đăng nhập"
                                    Click="LoginButton_Click"/>

                            <Button Height="38"
                                    Margin="0,12,0,0"
                                    Content="Đăng ký tài khoản Student"
                                    Click="ShowRegisterButton_Click"/>

                            <TextBlock x:Name="MessageText"
                                       Margin="0,14,0,0"
                                       Foreground="Crimson"
                                       TextWrapping="Wrap"/>

                            <Border Margin="0,20,0,0"
                                    Padding="14"
                                    Background="#EFF6FF"
                                    CornerRadius="10">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="Tài khoản demo"/>
                                    <TextBlock Text="Admin: admin@FUManagementSystem.org / @@abc123@@"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- REGISTER PANEL -->
                        <StackPanel x:Name="RegisterPanel" Visibility="Collapsed">
                            <TextBlock Margin="0,10,0,14"
                                       Foreground="#475569"
                                       Text="Tạo tài khoản mới với vai trò Student. StudentCode sẽ được sinh tự động khi lưu vào database."
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="Họ và tên *"/>
                            <TextBox x:Name="RegisterFullNameTextBox"
                                     Margin="0,8,0,12"
                                     Height="36"/>

                            <TextBlock Text="Username *"/>
                            <TextBox x:Name="RegisterUsernameTextBox"
                                     Margin="0,8,0,12"
                                     Height="36"/>

                            <TextBlock Text="Email *"/>
                            <TextBox x:Name="RegisterEmailTextBox"
                                     Margin="0,8,0,12"
                                     Height="36"/>

                            <TextBlock Text="Mật khẩu *"/>
                            <PasswordBox x:Name="RegisterPasswordBox"
                                         Margin="0,8,0,12"
                                         Height="36"/>

                            <TextBlock Text="Xác nhận mật khẩu *"/>
                            <PasswordBox x:Name="RegisterConfirmPasswordBox"
                                         Margin="0,8,0,12"
                                         Height="36"/>

                            <TextBlock Text="Số điện thoại"/>
                            <TextBox x:Name="RegisterPhoneTextBox"
                                     Margin="0,8,0,12"
                                     Height="36"/>

                            <TextBlock Text="Ngày sinh"/>
                            <DatePicker x:Name="RegisterDateOfBirthPicker"
                                        Margin="0,8,0,12"
                                        Height="36"/>

                            <TextBlock Text="Giới tính"/>
                            <ComboBox x:Name="RegisterGenderComboBox"
                                      Margin="0,8,0,12"
                                      Height="36"
                                      SelectedIndex="0">
                                <ComboBoxItem Content=""/>
                                <ComboBoxItem Content="Male"/>
                                <ComboBoxItem Content="Female"/>
                                <ComboBoxItem Content="Other"/>
                            </ComboBox>

                            <TextBlock Text="Địa chỉ"/>
                            <TextBox x:Name="RegisterAddressTextBox"
                                     Margin="0,8,0,18"
                                     Height="72"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"/>

                            <Button Height="40"
                                    Content="Tạo tài khoản"
                                    Click="RegisterButton_Click"/>

                            <Button Height="38"
                                    Margin="0,12,0,0"
                                    Content="Quay lại đăng nhập"
                                    Click="BackToLoginButton_Click"/>

                            <TextBlock x:Name="RegisterMessageText"
                                       Margin="0,14,0,0"
                                       Foreground="Crimson"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>