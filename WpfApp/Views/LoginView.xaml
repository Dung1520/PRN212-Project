<UserControl x:Class="WpfApp.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#FFF5F7FB">
        <Border Width="480" Padding="28" Background="White" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Đăng nhập hệ thống" FontSize="28" FontWeight="Bold"/>
                

                <TextBlock Text="Username hoặc Email"/>
                <TextBox x:Name="UsernameTextBox" Margin="0,8,0,14" Height="36"/>

                <TextBlock Text="Mật khẩu"/>
                <PasswordBox x:Name="PasswordTextBox" Margin="0,8,0,18" Height="36"/>

                <Button Height="40" Content="Đăng nhập" Click="LoginButton_Click"/>
                <TextBlock x:Name="MessageText" Margin="0,14,0,0" Foreground="Crimson" TextWrapping="Wrap"/>

                <Border Margin="0,20,0,0" Padding="14" Background="#EFF6FF" CornerRadius="10">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="Tài khoản demo trong DB"/>
                        <TextBlock Text="Admin: admin@FUManagementSystem.org / “@@abc123@@"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
