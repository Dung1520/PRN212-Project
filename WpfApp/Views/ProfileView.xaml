<UserControl x:Class="WpfApp.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#F8FAFC" Padding="20" CornerRadius="12">
        <StackPanel>
            <TextBlock Text="Hồ sơ người dùng" FontSize="26" FontWeight="Bold" Margin="0,0,0,12"/>
            <TextBlock x:Name="ProfileText" TextWrapping="Wrap" FontSize="15"/>
        </StackPanel>
    </Border>
</UserControl>