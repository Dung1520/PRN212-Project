<Window x:Class="WpfApp.StudentScheduleDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="StudentScheduleDetailWindow" Height="300" Width="500">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="txtClassInfo" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock x:Name="txtTeacher" Margin="0,0,0,6"/>
            <TextBlock x:Name="txtRoom" Margin="0,0,0,6"/>
            <TextBlock x:Name="txtTime" Margin="0,0,0,6"/>
        </StackPanel>

        <Button Grid.Row="1" Content="Close" Width="100" HorizontalAlignment="Right" Click="Close_Click"/>
    </Grid>
</Window>
