<UserControl x:Class="WpfApp.Views.StudentEnrollmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Đăng ký của tôi" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>
        <DataGrid x:Name="EnrollmentGrid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Course" Binding="{Binding CourseName}" Width="180"/>
                <DataGridTextColumn Header="Class" Binding="{Binding ClassCode}" Width="90"/>
                <DataGridTextColumn Header="Day" Binding="{Binding DayOfWeek}" Width="110"/>
                <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="160"/>
                <DataGridTextColumn Header="Start" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                <DataGridTextColumn Header="End" Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                <DataGridTemplateColumn Header="Action" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Cancel" Tag="{Binding ClassId}" Click="Cancel_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>