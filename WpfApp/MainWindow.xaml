<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LCTMS Management System" Height="840" Width="1460" WindowStartupLocation="CenterScreen">
    <Grid Background="#FFF5F7FB">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#172554">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,20,20,12">
                    <TextBlock x:Name="AppTitleText" Text="AECMS" Foreground="White" FontSize="28" FontWeight="Bold"/>
                    <TextBlock x:Name="UserInfoText" Text="Not logged in" Foreground="#BFDBFE" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <ListBox x:Name="NavListBox"
                         DockPanel.Dock="Top"
                         Margin="12"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         SelectionChanged="NavListBox_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="14,12"/>
                            <Setter Property="Margin" Value="0,4,0,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#1D4ED8"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1E3A8A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <Button x:Name="LogoutButton" DockPanel.Dock="Bottom" Margin="16" Height="42" Content="Đăng xuất" Click="LogoutButton_Click"/>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Margin="18" Padding="18" Background="White" CornerRadius="16">
            <ContentControl x:Name="MainContent"/>
        </Border>
    </Grid>
</Window>